{
  "name": "mocktown",
  "version": "0.2.0",
  "type": "module",
  "description": "Record an app's outbound traffic, serve it back as stateful mocks, and keep them alive as the real services change.",
  "keywords": [
    "mocking",
    "http",
    "proxy",
    "testing",
    "sandbox",
    "agents",
    "mcp",
    "bun"
  ],
  "homepage": "https://github.com/gkurt/mocktown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/mocktown.git",
    "directory": "packages/mocktown"
  },
  "bugs": {
    "url": "https://github.com/gkurt/mocktown/issues"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "author": {
    "name": "Gokhan Kurt",
    "url": "https://github.com/gkurt"
  },
  "bin": {
    "mocktown": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mocks/types.ts",
    "./contract": "./src/contract/index.ts"
  },
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "daemon": "bun src/daemon/index.ts",
    "test": "bun test",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "prepack": "bun ../../scripts/prepack.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/openapi-client": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/zod": "1.15.0",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "mockttp": "4.6.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.10"
  },
  "optionalDependencies": {
    "@libsql/client": "0.17.4"
  },
  "files": [
    "src",
    "drizzle",
    "gui-dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
