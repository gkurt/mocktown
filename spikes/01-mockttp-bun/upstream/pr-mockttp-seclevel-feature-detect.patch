-}
\ No newline at end of file
+}
+
+let secLevelSupport: boolean | undefined;
+
+export function isSecLevelSupported() {
+    // The @SECLEVEL cipher-string directive is an OpenSSL extension. Other TLS backends
+    // that present themselves as OpenSSL-compatible (notably BoringSSL, used by Bun and
+    // others) don't implement it, and reject the *entire* cipher string with
+    // ERR_SSL_INVALID_COMMAND rather than ignoring the unknown directive.
+
+    // This has to be feature-detected rather than derived from process.versions.openssl,
+    // because that value isn't reliable: Bun reports '1.1.0', a real OpenSSL version that
+    // does support @SECLEVEL.
+
+    // The result can't change within a process, so we detect once and cache.
+    if (secLevelSupport === undefined) {
+        try {
+            tls.createSecureContext({ ciphers: 'AES128-SHA:@SECLEVEL=0' });
+            secLevelSupport = true;
+        } catch (e) {
+            secLevelSupport = false;
+        }
+    }
+    return secLevelSupport;
+}
